# Default: real API. Mock requires explicit opt-in and works only in Vite dev.
VITE_AUTH_MODE=api
VITE_API_BASE_URL=/api/v1

# Development-only mock transport, independent from Auth. Default api stays gated
# until Backend inbound contract and real workspace/channel IDs are integrated.
VITE_WS_MODE=api

# Development-only local search; requires Mock WebSocket messages as well.
# api remains gated until Backend response schema and real room IDs are confirmed.
VITE_SEARCH_MODE=api
